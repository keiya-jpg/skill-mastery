# Copy to .env.local for local development. In Vercel, add these under Settings > Environment Variables.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for one thing: saving newly built skills to the shared catalog. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI: at least one. Groq is tried first (fast), Gemini takes over when Groq is busy.
GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Limits per account per day
# AI_DAILY_REQUEST_LIMIT=40
# SKILL_DAILY_LIMIT=5

# Offline stand-in AI for local testing. Never set in production.
# AI_MOCK=1
